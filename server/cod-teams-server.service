[Unit]
Description=COD Teams Screenshot Analysis Server
After=network.target

[Service]
Type=simple
User=rolf
WorkingDirectory=/home/rolf/git/cod-teams/server
ExecStart=/home/rolf/.local/share/fnm/node-versions/v22.13.1/installation/bin/node index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
